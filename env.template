# Database (local development against the published dev profile)
DATABASE_URL=mysql://fieldvisits:fieldvisits_dev_password@127.0.0.1:3306/field_visits
DB_POOL_SIZE=10
MYSQL_DATABASE=field_visits
MYSQL_USER=fieldvisits
MYSQL_PASSWORD=fieldvisits_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# Session signing secret — MUST be 32+ random characters in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Runtime ("development" locally, "production" on live servers)
NODE_ENV=development
PORT=3000
UPLOAD_DIR=uploads

# Set to 1 only when Node sits behind Nginx or Caddy. Docker production sets this on the app service.
TRUST_PROXY=0

# Month boundaries for staff KPIs. Docker production defaults to Asia/Riyadh.
APP_TIMEZONE=Asia/Riyadh

# Public hostname for the production Caddy service (example.com). localhost uses Caddy's local certificate.
SITE_ADDRESS=localhost

# Demo mode is opt-in for local evaluation only (must be false or unset in production)
DEMO_MODE_ENABLED=false

# Initial administrator. Both OPENID and PASSWORD are required in production.
# OPENID is not defaulted to "admin"; set it explicitly even if the username is admin.
# INITIAL_ADMIN_OPENID=ops-admin
# INITIAL_ADMIN_PASSWORD=ReplaceWithAUniquePassword
# INITIAL_ADMIN_EMAIL=admin@sindean.local
